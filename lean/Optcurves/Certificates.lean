import Mathlib

/-!
# Exact certificates: gradient descent cannot break curve convexity n times in a row

Generated by `python -m optcurves.lean_gen` from `certificates/*.json`. Do not edit by hand.

Setting (L = 1; the general case follows by rescaling f): gradient descent `x (k+1) = x k - h • g k`,
`g k` the gradient and `f k` the value at `x k`. Curve violation `v k = 2 f k - f (k-1) - f (k+1)`.

**Scope.** The hypotheses are the interpolation inequalities of 1-smooth convex functions,
`f j + ⟪g j, x i - x j⟫ + ½‖g i - g j‖² ≤ f i`. Every 1-smooth convex function satisfies them
(Nesterov 2004, Thm 2.1.5), but that bridge lemma is *not* proved here.
-/

namespace Optcurves

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- Interpolation inequality for a 1-smooth convex function between points `i` and `j`. -/
def Interp (xi xj gi gj : E) (fi fj : ℝ) : Prop :=
  fj + inner ℝ gj (xi - xj) + (1 / 2) * ‖gi - gj‖ ^ 2 ≤ fi


/-- Step size h = 9/5 (≈ 1.8000), window of 2 consecutive curve violations.
Weighted claim: w1 v1 + w2 v2 <= 0 with w = (81/124, 43/124).
Certificate: 5 interpolation inequalities and 3 squares. -/
theorem no_consecutive_n2_h9_5_weighted (x g : ℕ → E) (f : ℕ → ℝ)
    (hgd : ∀ k, x (k + 1) = x k - (9 / 5 : ℝ) • g k)
    (hI : ∀ i j, Interp (x i) (x j) (g i) (g j) (f i) (f j)) :
    (81 / 124 : ℝ) * (2 * f 1 - f 0 - f 2) + (43 / 124 : ℝ) * (2 * f 2 - f 1 - f 3) ≤ 0 := by
  have e1 : x 1 = x 0 - (9 / 5 : ℝ) • g 0 := hgd 0
  have e2 : x 2 = x 0 - (9 / 5 : ℝ) • g 0 - (9 / 5 : ℝ) • g 1 := by
    have h' := hgd 1; rw [e1] at h'; exact h'
  have e3 : x 3 = x 0 - (9 / 5 : ℝ) • g 0 - (9 / 5 : ℝ) • g 1 - (9 / 5 : ℝ) • g 2 := by
    have h' := hgd 2; rw [e2] at h'; exact h'
  have q01 := hI 0 1
  rw [e1] at q01
  have q02 := hI 0 2
  rw [e2] at q02
  have q20 := hI 2 0
  rw [e2] at q20
  have q31 := hI 3 1
  rw [e3, e1] at q31
  have q32 := hI 3 2
  rw [e3, e2] at q32
  have s0 : 0 ≤ ‖(1 : ℝ) • (g 0 - g 3) + (7 / 162 : ℝ) • (g 1 - g 3) + (-169 / 162 : ℝ) • (g 2 - g 3)‖ ^ 2 := by positivity
  have s1 : 0 ≤ ‖(1 : ℝ) • (g 1 - g 3) + (8473 / 35267 : ℝ) • (g 2 - g 3)‖ ^ 2 := by positivity
  have s2 : 0 ≤ ‖(1 : ℝ) • (g 2 - g 3)‖ ^ 2 := by positivity
  unfold Interp at q01 q02 q20 q31 q32
  simp only [← real_inner_self_eq_norm_sq] at q01 q02 q20 q31 q32 s0 s1 s2
  simp only [inner_add_left, inner_add_right, inner_sub_left, inner_sub_right,
    real_inner_smul_left, real_inner_smul_right] at q01 q02 q20 q31 q32 s0 s1 s2
  linarith [real_inner_comm (x 0) (g 0),
    real_inner_comm (x 0) (g 1),
    real_inner_comm (x 0) (g 2),
    real_inner_comm (x 0) (g 3),
    real_inner_comm (g 0) (g 1),
    real_inner_comm (g 0) (g 2),
    real_inner_comm (g 0) (g 3),
    real_inner_comm (g 1) (g 2),
    real_inner_comm (g 1) (g 3),
    real_inner_comm (g 2) (g 3)]

/-- At h = 9/5, the curve cannot be strictly concave at 2 consecutive steps. -/
theorem no_consecutive_n2_h9_5 (x g : ℕ → E) (f : ℕ → ℝ)
    (hgd : ∀ k, x (k + 1) = x k - (9 / 5 : ℝ) • g k)
    (hI : ∀ i j, Interp (x i) (x j) (g i) (g j) (f i) (f j)) :
    ¬ (0 < (2 * f 1 - f 0 - f 2) ∧ 0 < (2 * f 2 - f 1 - f 3)) := by
  rintro ⟨a1, a2⟩
  have := no_consecutive_n2_h9_5_weighted x g f hgd hI
  linarith

