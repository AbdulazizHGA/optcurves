    have h' := hgd 1; rw [e1] at h'; exact h'
  have e3 : x 3 = x 0 - (19 / 10 : ℝ) • g 0 - (19 / 10 : ℝ) • g 1 - (19 / 10 : ℝ) • g 2 := by
