theorem no_consecutive_n3_h19_10_weighted (x g : ℕ → E) (f : ℕ → ℝ)
    (hgd : ∀ k, x (k + 1) = x k - (19 / 10 : ℝ) • g k)
    (hI : ∀ i j, Interp (x i) (x j) (g i) (g j) (f i) (f j)) :
    (13151 / 27300 : ℝ) * (2 * f 1 - f 0 - f 2) + (107 / 300 : ℝ) * (2 * f 2 - f 1 - f 3) + (1103 / 6825 : ℝ) * (2 * f 3 - f 2 - f 4) ≤ 0 := by
